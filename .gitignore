# Environments
.venv/
__pycache__/
*.pyc
*.pyo

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Results — keep small artifacts (config.yaml, metrics.json, design_card.json, xai/*.npz),
# exclude only raw checkpoints
results/runs/*/checkpoints/

# Expensive-but-regenerable reference caches (T0.12+) -- deterministic from code + config,
# regenerated on demand rather than committed as binary blobs
results/reference/

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.xdv
paper/*.synctex.gz

# Packaging / notebooks
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Claude-flow / tooling scratch
.claude-flow/
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.metals/
.bloop/
results/figures/
